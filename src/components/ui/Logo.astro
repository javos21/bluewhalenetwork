---
interface Props {
  label?: string;
  class?: string;
}
const { label = 'BlueWhale', class: className = '' } = Astro.props;
---

<a href="#home" class={`inline-flex items-center gap-2 ${className}`}>
  <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-blue">
    <!-- Sprout / leaf mark -->
    <path d="M12 21V11" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
    <path d="M12 11C12 7.5 9.5 5 6 5C6 8.5 8.5 11 12 11Z" fill="currentColor"/>
    <path d="M12 13C12 9.5 14.5 7 18 7C18 10.5 15.5 13 12 13Z" fill="currentColor" opacity="0.6"/>
  </svg>
  <span class="font-black text-xl tracking-tight">{label}</span>
</a>

---
import { footer } from '@/data/site';
import Logo from '@/components/ui/Logo.astro';
---

<footer class="container-xl pb-10">
  <div class="border-t border-ink/10 pt-12">
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-10">
      <!-- Brand -->
      <div class="lg:col-span-2">
        <Logo label="BlueWhale" class="text-ink" />
        <p class="mt-4 text-body1 text-ink/55 max-w-xs">{footer.tagline}</p>
      </div>

      <!-- Link columns -->
      {footer.columns.map((col) => (
        <ul class="space-y-3">
          {col.links.map((link) => (
            <li>
              <a href={link.href} class="text-body1 text-ink/60 hover:text-blue transition-colors">{link.label}</a>
            </li>
          ))}
        </ul>
      ))}
    </div>

    <!-- Bottom bar -->
    <div class="mt-12 pt-6 border-t border-ink/10 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-body2 text-ink/40">{footer.legal}</p>
      <div class="flex flex-wrap gap-6 justify-center">
        {footer.legalLinks.map((l) => (
          <a href={l.href} class="text-body2 text-ink/40 hover:text-ink/70 transition-colors">{l.label}</a>
        ))}
      </div>
    </div>
  </div>
</footer>

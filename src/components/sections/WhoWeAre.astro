---
import { about } from '@/data/site';
import Photo from '@/components/ui/Photo.astro';
---

<section id="about" class="section">
  <div class="container-xl">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <!-- Left: image -->
      <div class="reveal">
        <Photo
          src="/images/about-meeting.jpg"
          alt="BlueWhale advisors celebrating with a client at a meeting"
          ratio="aspect-[5/4]"
          rounded="rounded-[32px]"
        />
      </div>

      <!-- Right: copy + stats -->
      <div class="reveal">
        <span class="eyebrow">{about.eyebrow}</span>
        <p class="mt-5 text-h5 sm:text-[1.75rem] sm:leading-[2.25rem] text-ink font-bold">
          {about.body}
        </p>

        <a href={about.cta.href} class="inline-flex items-center gap-2 mt-6 text-body1 font-bold text-blue hover:gap-3 transition-all">
          {about.cta.label}
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4">
            <path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z" clip-rule="evenodd" />
          </svg>
        </a>

        <!-- Stats card -->
        <div class="mt-10 card-soft p-6 sm:p-7">
          <div class="text-caption uppercase tracking-[0.12em] text-ink/40 mb-5">{about.statsLabel}</div>
          <div class="grid grid-cols-3 gap-4 divide-x divide-ink/10">
            {about.stats.map((s, i) => (
              <div class={i === 0 ? 'pr-2' : 'px-2'}>
                <div class="text-h5 sm:text-h4 text-ink leading-none">{s.value}</div>
                <div class="mt-2 text-body2 text-ink/50">{s.label}</div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

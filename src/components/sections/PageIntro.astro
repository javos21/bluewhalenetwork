---
// Inner-page header: the surface. Paper sky, the headline, and a short
// still ocean running into the ice-blue page body below.
import RevealHeading from '@/components/motion/RevealHeading.astro';
import OceanSurface from '@/components/ocean/OceanSurface.astro';

interface Props {
  lines: string[];
  lede?: string;
}
const { lines, lede } = Astro.props;
---

<section class="page-intro tone-paper relative overflow-hidden">
  <div class="container-site relative z-[3] pt-14 pb-[clamp(7rem,14vw,10rem)] sm:pt-20 lg:pt-24">
    <RevealHeading as="h1" lines={lines} class="display max-w-5xl text-[clamp(2.25rem,1.2rem+3.8vw,4.6rem)]" />
    {lede && <p class="lede reveal mt-7 max-w-2xl text-slate" data-reveal style="--delay:200ms">{lede}</p>}
    <slot />
  </div>
  <OceanSurface front="var(--color-ice)" class="page-intro-ocean" />
</section>

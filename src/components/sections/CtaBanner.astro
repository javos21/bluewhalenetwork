---
import { cta } from '@/data/site';
---

<section class="container-xl py-6">
  <div class="relative overflow-hidden rounded-card bg-blue text-center px-6 py-16 sm:py-20 reveal">
    <!-- Decorative leaf / sprout pattern -->
    <svg class="absolute inset-x-0 bottom-0 w-full h-32 text-white/10" viewBox="0 0 1200 160" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" preserveAspectRatio="none">
      {Array.from({ length: 13 }, (_, i) => i * 100 + 20).map((x) => (
        <g transform={`translate(${x} 160)`} fill="currentColor">
          <path d="M0 0V-60" stroke="currentColor" stroke-width="3"/>
          <path d="M0 -30C0 -50 -16 -64 -38 -64C-38 -42 -22 -28 0 -30Z"/>
          <path d="M0 -42C0 -62 16 -76 38 -76C38 -54 22 -40 0 -42Z" opacity="0.7"/>
        </g>
      ))}
    </svg>
    <div class="absolute -top-16 -right-10 w-64 h-64 rounded-full bg-white/10 blur-2xl" aria-hidden="true"></div>

    <div class="relative z-10 max-w-2xl mx-auto">
      <h2 class="text-[1.75rem] leading-[1.15] sm:text-h4 text-white">{cta.headline}</h2>
      <p class="mt-4 text-body1 text-white/80">{cta.subtext}</p>
      <div class="mt-8 flex justify-center">
        <a href={cta.cta.href} class="btn-white">
          {cta.cta.label}
          <span class="btn-arrow">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4">
              <path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z" clip-rule="evenodd" />
            </svg>
          </span>
        </a>
      </div>
    </div>
  </div>
</section>

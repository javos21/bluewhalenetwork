---
// The four offers, each with its promise, timeline and delivery, leading to
// its own page. Pricing stays off the site.
import DepthSection from '@/components/ocean/DepthSection.astro';
import RevealHeading from '@/components/motion/RevealHeading.astro';
import { solutions } from '@/data/home';
import { offers, offerHref } from '@/data/offers';
---

<DepthSection tone="paper" next="deep" side="left" labelledby="offers-heading">
  <RevealHeading id="offers-heading" lines={solutions.lines} class="display text-[clamp(2.2rem,1.4rem+2.8vw,3.75rem)]" />
  <p class="lede reveal mt-6 max-w-2xl text-slate" data-reveal>{solutions.intro}</p>

  <ol class="mt-12 grid gap-4 sm:grid-cols-2">
    {offers.map((offer, i) => (
      <li class="reveal" data-reveal style={`--delay:${i * 80}ms`}>
        <a href={offerHref(offer.slug)} class="offer-card group">
          <span class="text-sm font-semibold tabular-nums text-current" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="heading mt-5 text-[1.45rem]">{offer.name}</h3>
          <p class="mt-3 text-slate">{offer.promise}</p>
          <p class="mt-6 border-t border-rule pt-4 text-sm text-slate"><span class="text-midnight">{offer.timeline}.</span> {offer.delivery}.</p>
          <span class="link-arrow mt-6 text-deep">Explore<span class="sr-only"> {offer.name}</span><span class="btn-arrow" aria-hidden="true">→</span></span>
        </a>
      </li>
    ))}
  </ol>

  <a href={solutions.allLink.href} class="link-arrow reveal mt-10 text-deep" data-reveal>
    {solutions.allLink.label}<span class="btn-arrow" aria-hidden="true">→</span>
  </a>
</DepthSection>

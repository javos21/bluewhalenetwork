---
import RevealHeading from '@/components/motion/RevealHeading.astro';
import { solutions } from '@/data/home';
import { featuredOfferSlugs, offerBySlug, offerHref } from '@/data/offers';

const featured = featuredOfferSlugs.map((slug) => offerBySlug(slug)!);
---

<section class="bg-ice py-20 sm:py-28 lg:py-32" aria-labelledby="solutions-heading">
  <div class="container-site">
    <div class="grid gap-8 lg:grid-cols-12">
      <RevealHeading
        id="solutions-heading"
        lines={solutions.lines}
        class="heading text-[clamp(2rem,1.3rem+2.6vw,3.5rem)] text-deep lg:col-span-7"
      />
      <p class="reveal text-slate lg:col-span-5 lg:pt-3" data-reveal>{solutions.intro}</p>
    </div>

    <ul class="mt-14 grid gap-4 md:grid-cols-3 md:gap-5">
      {featured.map((offer, i) => (
        <li class="reveal" data-reveal style={`--delay:${i * 90}ms`}>
          <article class="card-hover group relative flex h-full flex-col rounded-xl border border-rule bg-white p-7 hover:border-current sm:p-8">
            <h3 class="heading text-2xl text-midnight">
              <a href={offerHref(offer.slug)} class="after:absolute after:inset-0 after:rounded-xl focus-visible:outline-none">
                {offer.name}
              </a>
            </h3>
            <p class="mt-4 flex-1 text-slate">{offer.summary}</p>
            <span class="link-arrow mt-8 text-deep group-hover:[text-decoration-color:currentColor]" aria-hidden="true">
              {solutions.cardCta[offer.slug] ?? offer.cta}<span class="btn-arrow group-hover:translate-x-1">→</span>
            </span>
          </article>
        </li>
      ))}
    </ul>

    <a href={solutions.allLink.href} class="link-arrow reveal mt-10 text-deep" data-reveal>
      {solutions.allLink.label}<span class="btn-arrow" aria-hidden="true">→</span>
    </a>
  </div>
</section>

<style>
  /* Keyboard focus lands on the stretched link; draw the ring on the card. */
  article:has(a:focus-visible) {
    outline: 2px solid var(--color-current);
    outline-offset: 3px;
  }
</style>

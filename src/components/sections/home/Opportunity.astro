---
// "Growth Begins With Seeing What's Possible." The opening statement
// fills in word by word as it scrolls; oversized flow bands from the mark
// drift behind it (parallax).
import RevealHeading from '@/components/motion/RevealHeading.astro';
import ScrollFill from '@/components/motion/ScrollFill.astro';
import StatsBand from '@/components/labs/StatsBand.astro';
import { markPaths, MARK_VIEWBOX } from '@/lib/logo';
import { opportunity } from '@/data/home';
import { showLabs } from '@/lib/env';

const [statement, ...rest] = opportunity.body;
---

<section class="relative overflow-hidden py-20 sm:py-28 lg:py-32" aria-labelledby="opportunity-heading">
  <!-- Oversized brand bands bleeding off the right edge -->
  <svg
    viewBox={MARK_VIEWBOX}
    class="pointer-events-none absolute -right-[22rem] top-16 w-[56rem] max-w-none opacity-[0.09] max-sm:hidden"
    data-parallax="0.12"
    aria-hidden="true"
    focusable="false"
  >
    {markPaths.bands.map((b) => <path d={b.d} fill="var(--color-deep)" />)}
  </svg>

  <div class="container-site relative">
    <RevealHeading
      id="opportunity-heading"
      lines={opportunity.lines}
      class="heading text-[clamp(1.5rem,1.2rem+1vw,2rem)] text-deep"
    />

    <div class="mt-8 grid gap-10 lg:grid-cols-12 lg:gap-8">
      <ScrollFill
        text={statement}
        class="display text-[clamp(1.9rem,1.1rem+2.6vw,3.4rem)] leading-[1.12] lg:col-span-9"
      />
      <!-- Side card: the approach in four words -->
      <div class="pop grid-paper flex flex-col justify-between gap-6 rounded-2xl p-6 shadow-[0_14px_40px_rgb(0_21_27/0.08)] lg:col-span-3 lg:self-start" data-reveal style="--delay:150ms">
        <span class="chip-icon"><svg viewBox={MARK_VIEWBOX} class="w-6" aria-hidden="true">{markPaths.bands.map((b) => <path d={b.d} fill="var(--color-aqua)" />)}<path d={markPaths.whale} fill="#fff" /></svg></span>
        <p class="heading text-xl leading-snug">
          Identify. Develop.<br />Connect. <span class="highlight">Advance.</span>
        </p>
      </div>
    </div>

    <div class="mt-12 grid gap-6 text-slate sm:grid-cols-2 lg:max-w-4xl">
      {rest.map((p, i) => <p class="reveal" data-reveal style={`--delay:${i * 100}ms`}>{p}</p>)}
    </div>

    {showLabs && <div class="mt-16"><StatsBand /></div>}
  </div>
</section>

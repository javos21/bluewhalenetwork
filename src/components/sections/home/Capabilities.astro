---
// What We Do — the four capabilities as an accordion in midnight water.
// The open row carries the description and the areas of work.
import DepthSection from '@/components/ocean/DepthSection.astro';
import RevealHeading from '@/components/motion/RevealHeading.astro';
import Icon from '@/components/ui/Icon.astro';
import { capabilities } from '@/data/home';
import { capabilityList } from '@/data/capabilities';
---

<DepthSection tone="midnight" next="paper" side="left" labelledby="capabilities-heading">
  <div class="flex flex-wrap items-end justify-between gap-x-8 gap-y-4">
    <RevealHeading id="capabilities-heading" lines={capabilities.lines} class="display text-[clamp(2.2rem,1.4rem+2.8vw,3.75rem)]" />
    <a href={capabilities.cta.href} class="link-arrow reveal text-aqua" data-reveal>
      {capabilities.cta.label}<span class="btn-arrow" aria-hidden="true">→</span>
    </a>
  </div>

  <div class="accordion mt-12 border-t border-white/12">
    {capabilityList.map((cap, i) => (
      <details name="capabilities" open={i === 0} class="reveal group border-b border-white/12" data-reveal style={`--delay:${i * 80}ms`}>
        <summary class="flex items-center gap-5 py-6 sm:py-7">
          <span class="grid size-10 shrink-0 place-items-center rounded-full bg-deep text-aqua transition-colors duration-300 group-open:bg-aqua group-open:text-midnight">
            <Icon name={cap.icon} class="size-[1.15rem]" />
          </span>
          <span class="heading flex-1 text-xl sm:text-2xl">{cap.title}</span>
          <span class="grid size-9 shrink-0 place-items-center rounded-full border border-white/20 text-aqua transition-transform duration-300 group-open:rotate-45" aria-hidden="true">
            <Icon name="plus" class="size-4" />
          </span>
        </summary>
        <div class="pb-8 sm:pl-[3.75rem]">
          <p class="max-w-xl text-aqua">{cap.body}</p>
          <ul class="mt-6 grid gap-x-8 gap-y-2.5 text-white/90 sm:grid-cols-2">
            {cap.areas.map((a) => <li class="flex gap-3"><span class="mt-2.5 size-1.5 shrink-0 rounded-full bg-aqua"></span>{a}</li>)}
          </ul>
        </div>
      </details>
    ))}
  </div>
</DepthSection>

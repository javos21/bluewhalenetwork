---
import { focus } from '@/data/site';
import Photo from '@/components/ui/Photo.astro';
---

<section id="focus" class="section pt-0">
  <div class="container-xl">
    <!-- Header row -->
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-6 mb-10 reveal">
      <h2 class="text-[2rem] leading-[1.1] sm:text-h3 lg:text-h2 text-ink">
        <span class="block">{focus.eyebrowA}</span>
        <span class="block">{focus.eyebrowB}</span>
      </h2>

      <!-- Carousel controls -->
      <div class="flex items-center gap-3">
        <button id="focus-prev" class="nav-circle bg-white text-ink hover:bg-cloud border border-ink/10" aria-label="Previous">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-5 h-5">
            <path fill-rule="evenodd" d="M17 10a.75.75 0 01-.75.75H5.612l4.158 3.96a.75.75 0 11-1.04 1.08l-5.5-5.25a.75.75 0 010-1.08l5.5-5.25a.75.75 0 111.04 1.08L5.612 9.25H16.25A.75.75 0 0117 10z" clip-rule="evenodd" />
          </svg>
        </button>
        <button id="focus-next" class="nav-circle bg-blue text-white hover:bg-blue-dark" aria-label="Next">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-5 h-5">
            <path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z" clip-rule="evenodd" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Cards track -->
    <div id="focus-track" class="flex gap-6 overflow-x-auto scroll-smooth pb-4 snap-x snap-mandatory [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
      {focus.cards.map((card) => (
        <article
          class={`group snap-start shrink-0 w-[300px] sm:w-[360px] rounded-card p-6 flex flex-col transition-all duration-300 ${
            card.featured ? 'bg-blue text-white' : 'bg-white text-ink shadow-card'
          }`}
        >
          <div class="flex items-start justify-between gap-3">
            <span class={`tag-pill ${card.featured ? 'border-white/30 text-white' : 'border-ink/15 text-ink/60'}`}>
              {card.tag}
            </span>
            <span class={`flex items-center justify-center w-9 h-9 rounded-full shrink-0 ${card.featured ? 'bg-white/20 text-white' : 'bg-cloud text-ink'}`}>
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4">
                <path fill-rule="evenodd" d="M5.22 14.78a.75.75 0 001.06 0l7.22-7.22v3.69a.75.75 0 001.5 0v-5.5a.75.75 0 00-.75-.75h-5.5a.75.75 0 000 1.5h3.69l-7.22 7.22a.75.75 0 000 1.06z" clip-rule="evenodd" />
              </svg>
            </span>
          </div>

          <h3 class={`mt-5 text-h5 ${card.featured ? 'text-white' : 'text-ink'}`}>{card.title}</h3>
          <p class={`mt-3 text-body1 ${card.featured ? 'text-white/80' : 'text-ink/55'}`}>{card.description}</p>

          <div class="mt-6">
            <Photo
              src={card.image}
              alt={card.alt}
              ratio="aspect-[16/10]"
              rounded="rounded-[18px]"
            />
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  const track = document.getElementById('focus-track')!;
  const step  = 384; // card width + gap
  document.getElementById('focus-prev')?.addEventListener('click', () => track.scrollBy({ left: -step, behavior: 'smooth' }));
  document.getElementById('focus-next')?.addEventListener('click', () => track.scrollBy({ left:  step, behavior: 'smooth' }));
</script>

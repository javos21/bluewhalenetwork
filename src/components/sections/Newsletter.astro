---
import { newsletter } from '@/data/site';
---

<section class="container-xl py-10 lg:py-14">
  <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6 reveal">
    <h3 class="text-h5 sm:text-[1.75rem] text-ink max-w-md">{newsletter.heading}</h3>

    <form class="flex items-center gap-2 bg-white rounded-pill p-2 shadow-card w-full lg:w-auto lg:min-w-[420px]" onsubmit="return false">
      <input
        type="email"
        required
        placeholder={newsletter.placeholder}
        class="flex-1 bg-transparent px-4 py-2 text-body1 text-ink placeholder:text-ink/40 focus:outline-none"
      />
      <button type="submit" class="btn-blue shrink-0">
        {newsletter.cta}
        <span class="btn-arrow">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4">
            <path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z" clip-rule="evenodd" />
          </svg>
        </span>
      </button>
    </form>
  </div>
</section>

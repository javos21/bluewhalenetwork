---
// Temporary body for pages that are scaffolded but not yet built.
// Remove once each page gets its real content.
interface Props {
  step: string;
}
const { step } = Astro.props;
---

<section class="container-site py-20 sm:py-28">
  <div class="max-w-2xl border-l-2 border-current pl-6 text-slate">
    <p class="heading text-xl text-midnight">This page is being built.</p>
    <p class="mt-3">Planned in {step}. The structure and copy follow Nic's brief.</p>
  </div>
</section>

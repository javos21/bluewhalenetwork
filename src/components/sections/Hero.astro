---
// Home hero, recomposed after the Compally reference: centred headline
// with an Aqua highlight, a cut-out portrait rising out of a notched
// Current Blue block, floating capability chips joined by dashed
// connectors, and the CTAs in the first screen.
import RevealHeading from '@/components/motion/RevealHeading.astro';
import PortraitFrame from '@/components/ui/PortraitFrame.astro';
import Chip from '@/components/ui/Chip.astro';
import { primaryCta } from '@/data/site';

const hero = {
  lines: ['Turn Opportunities Into', 'Commercial Value.'],
  // Word carousel on the highlighted line. Nic's phrase always comes first;
  // the rest are suggestions listed in docs/copy-edits.md for his approval.
  rotate: ['New Revenue.', 'Lasting Growth.'],
  lede: 'Blue Whale identifies opportunities, develops commercial strategies and helps businesses bring ideas to market.',
  secondary: { label: 'Explore Our Solutions', href: '/services' },
};
---

<section class="on-dark relative overflow-hidden bg-midnight text-white" data-hero>
  <!-- Blueprint lines framing the composition (decorative) -->
  <svg class="draw pointer-events-none absolute inset-0 hidden h-full w-full lg:block" data-reveal style="--delay:500ms" aria-hidden="true" focusable="false" preserveAspectRatio="none">
    <line x1="0" y1="38%" x2="18%" y2="38%" stroke="rgb(255 255 255 / 0.16)" stroke-dasharray="5 7" />
    <line x1="18%" y1="38%" x2="18%" y2="62%" stroke="rgb(255 255 255 / 0.16)" stroke-dasharray="5 7" />
    <line x1="82%" y1="30%" x2="100%" y2="30%" stroke="rgb(255 255 255 / 0.16)" stroke-dasharray="5 7" />
    <line x1="82%" y1="30%" x2="82%" y2="70%" stroke="rgb(255 255 255 / 0.16)" stroke-dasharray="5 7" />
  </svg>

  <div class="container-site relative pt-12 sm:pt-16 lg:pt-20">
    <RevealHeading
      as="h1"
      lines={hero.lines}
      highlightLast
      rotate={hero.rotate}
      class="display mx-auto max-w-5xl text-center text-[clamp(2.4rem,1rem+5vw,5.4rem)]"
    />

    <div class="mt-10 grid items-end gap-10 lg:mt-12 lg:grid-cols-12 lg:gap-6">
      <!-- Left: proposition, CTAs and a real credential card -->
      <div class="order-1 flex flex-col items-center gap-7 text-center lg:col-span-4 lg:items-start lg:self-start lg:pt-6 lg:text-left">
        <p class="lede reveal max-w-md text-white/80" data-reveal style="--delay:350ms">{hero.lede}</p>
        <div class="reveal flex flex-wrap justify-center gap-3 lg:justify-start" data-reveal style="--delay:450ms">
          <a href={primaryCta.href} class="btn btn-accent">
            {primaryCta.label}<span class="btn-arrow" aria-hidden="true">→</span>
          </a>
          <a href={hero.secondary.href} class="btn btn-ghost-dark">{hero.secondary.label}</a>
        </div>
        <div class="pop grid-paper mt-4 hidden w-64 rounded-2xl p-5 text-midnight lg:block" data-reveal style="--delay:900ms">
          <p class="text-sm font-medium leading-snug text-slate">Founder experience across</p>
          <p class="mt-3 flex items-baseline gap-2">
            <span class="display text-5xl" data-count-to="5">5</span>
            <span class="text-lg font-semibold text-deep">industries</span>
          </p>
        </div>
      </div>

      <!-- Centre: portrait with floating chips -->
      <div class="order-2 lg:col-span-4">
        <div class="relative mx-auto w-[min(82vw,22rem)] lg:w-full lg:max-w-[24rem]">
          <PortraitFrame id="hero" tone="current" class="[--delay:250ms]" />
          <Chip icon="search" label="Opportunity Identification" class="absolute -left-4 top-[32%] sm:-left-16" delay={1050} floatDelay={0} />
          <Chip icon="network" label="Strategic Partnerships" class="absolute -right-3 top-[58%] sm:-right-14" delay={1200} floatDelay={1.4} />
        </div>
      </div>

      <!-- Right: two more capabilities, joined by a dashed connector -->
      <div class="order-3 hidden flex-col items-end gap-6 self-center lg:col-span-4 lg:flex">
        <div class="flex items-center gap-3">
          <svg class="draw h-px w-20 overflow-visible" data-reveal style="--delay:1250ms" aria-hidden="true"><line x1="0" y1="0" x2="80" y2="0" stroke="var(--color-aqua)" stroke-dasharray="4 5" /></svg>
          <span class="dot pop" data-reveal style="--delay:1250ms"></span>
          <Chip icon="compass" label="Commercial Strategy" delay={1300} floatDelay={0.7} />
        </div>
        <div class="flex items-center gap-3 pr-10">
          <svg class="draw h-px w-12 overflow-visible" data-reveal style="--delay:1400ms" aria-hidden="true"><line x1="0" y1="0" x2="48" y2="0" stroke="var(--color-aqua)" stroke-dasharray="4 5" /></svg>
          <span class="dot pop" data-reveal style="--delay:1400ms"></span>
          <Chip icon="spark" label="Innovation & Commercialisation" delay={1450} floatDelay={2.1} />
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { initHeroIntro } from '@/scripts/hero-intro';
  document.addEventListener('astro:page-load', initHeroIntro);
</script>

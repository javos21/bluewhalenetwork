---
// Count-up stats (preview only). Only the "5 industries" figure is real;
// the others are examples showing Nic which numbers to provide.
import ExampleTag from './ExampleTag.astro';
import { stats } from '@/data/labs';
---

<div class="border-y border-rule" aria-label="Key figures">
  <dl class="grid grid-cols-2 lg:grid-cols-4">
    {stats.map((s, i) => (
      <div class="reveal flex flex-col gap-3 border-rule py-8 pr-4 max-lg:[&:nth-child(odd)]:border-r lg:border-r lg:px-8 lg:first:pl-0 lg:last:border-r-0 max-lg:[&:nth-child(-n+2)]:border-b max-lg:[&:nth-child(even)]:pl-6" data-reveal style={`--delay:${i * 90}ms`}>
        <dt class="order-2 max-w-[12rem] text-sm text-slate">{s.label}</dt>
        <dd class="order-1 flex items-baseline gap-1">
          <span class="display text-5xl tabular-nums sm:text-6xl" data-count-to={s.value}>{s.value}</span>
          {s.suffix && <span class="display text-4xl text-current">{s.suffix}</span>}
        </dd>
        {!s.real && <div class="order-3"><ExampleTag class="text-current" text="Example figure" /></div>}
      </div>
    ))}
  </dl>
</div>

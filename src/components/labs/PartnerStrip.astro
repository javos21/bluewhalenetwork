---
// Partner logo strip (preview only). Fictional names show Nic where his
// partners' logos would go; nothing here implies a real relationship.
import ExampleTag from './ExampleTag.astro';
import { examplePartners } from '@/data/labs';

const marks: Record<string, string> = {
  diamond: '<path d="M12 3 21 12 12 21 3 12z"/>',
  wave: '<path d="M3 14c3-4 6-4 9 0s6 4 9 0"/><path d="M3 9c3-4 6-4 9 0s6 4 9 0"/>',
  circle: '<circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="3"/>',
  arch: '<path d="M4 20V11a8 8 0 0 1 16 0v9"/><path d="M9 20v-6a3 3 0 0 1 6 0v6"/>',
  spark: '<path d="M12 3v18M3 12h18M6 6l12 12M18 6 6 18"/>',
  bars: '<path d="M5 20V9M10 20V4M15 20v-8M20 20v-5"/>',
};
---

<section class="on-dark border-t border-white/10 bg-midnight text-white" aria-label="Partners (example)">
  <div class="container-site py-8 sm:py-10">
    <div class="flex justify-center"><ExampleTag text="Example partners — Nic to supply real logos with permission" class="text-aqua" /></div>
    <ul class="mt-6 grid grid-cols-2 gap-x-6 gap-y-5 sm:grid-cols-3 lg:flex lg:items-center lg:justify-between">
      {examplePartners.map((p, i) => (
        <li class="reveal flex items-center justify-center gap-2.5 text-white/55" data-reveal style={`--delay:${i * 70}ms`}>
          <svg viewBox="0 0 24 24" class="size-6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={marks[p.mark]} />
          <span class="text-lg font-semibold tracking-tight">{p.name}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

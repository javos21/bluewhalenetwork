---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageIntro from '@/components/sections/PageIntro.astro';
import EnquiryForm from '@/components/contact/EnquiryForm';
import { site } from '@/data/site';

// Cloudflare's documented always-pass test key, used when no real key is set
// (local dev and any preview without PUBLIC_TURNSTILE_SITE_KEY).
const TURNSTILE_TEST_KEY = '1x00000000000000000000AA';
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || TURNSTILE_TEST_KEY;
---

<BaseLayout title="Start a Conversation" description="Tell us about your business, idea or commercial challenge.">
  <PageIntro lines={['What Opportunity', 'Are You Looking', 'to Develop?']} lede="Tell us a little about your business, idea or commercial challenge." />

  <section class="bg-paper py-14 sm:py-20">
    <div class="container-site grid gap-12 lg:grid-cols-12">
      <div class="relative rounded-[1.5rem] bg-white p-6 sm:p-10 lg:col-span-8">
        <EnquiryForm client:visible siteKey={siteKey} fallbackEmail={site.email} />
        <noscript>
          <p class="text-slate">
            The enquiry form needs JavaScript. You can email us instead at
            <a class="text-deep underline" href={`mailto:${site.email}`}>{site.email}</a>.
          </p>
        </noscript>
      </div>
      <aside class="grid content-start gap-6 lg:col-span-3 lg:col-start-10">
        <div>
          <p class="text-sm text-slate">Prefer email?</p>
          <a href={`mailto:${site.email}`} class="heading mt-1 block break-all text-base text-deep hover:underline">{site.email}</a>
        </div>
        <div>
          <p class="text-sm text-slate">What happens next</p>
          <p class="mt-1 text-midnight/85">We read every enquiry and reply to arrange a conversation about the opportunity.</p>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageIntro from '@/components/sections/PageIntro.astro';
import { site } from '@/data/site';
---

<BaseLayout title="Start a Conversation" description="Tell us about your business, idea or commercial challenge.">
  <PageIntro lines={['What Opportunity', 'Are You Looking', 'to Develop?']} lede="Tell us a little about your business, idea or commercial challenge." />

  <section class="bg-ice py-14 sm:py-20">
    <div class="container-site grid gap-10 lg:grid-cols-12">
      <div class="rounded-[1.5rem] bg-white p-7 sm:p-10 lg:col-span-7">
        <h2 class="heading text-2xl">Send an enquiry</h2>
        <p class="mt-3 max-w-lg text-slate">The enquiry form is being connected. Until it’s live, email or call and we’ll start with a conversation about the opportunity.</p>
        <a href={`mailto:${site.email}`} class="btn btn-primary mt-8">Email Blue Whale<span class="btn-arrow" aria-hidden="true">→</span></a>
      </div>
      <address class="grid content-start gap-6 not-italic lg:col-span-4 lg:col-start-9">
        <div><p class="text-sm text-slate">Email</p><a href={`mailto:${site.email}`} class="heading mt-1 block break-all text-lg text-deep hover:underline">{site.email}</a></div>
        <div><p class="text-sm text-slate">Phone</p><a href={site.phoneHref} class="heading mt-1 block text-lg text-deep hover:underline">{site.phone}</a></div>
        <div><p class="text-sm text-slate">Based in</p><p class="heading mt-1 text-lg">{site.location}</p></div>
      </address>
    </div>
  </section>
</BaseLayout>
